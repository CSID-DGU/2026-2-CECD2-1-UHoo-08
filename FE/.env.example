VITE_API_BASE_URL=
VITE_AI_API_BASE_URL=
VITE_KAKAO_CLIENT_ID=
# 비워두면 현재 origin + /auth/social 을 사용한다 (로컬/프리뷰/프로덕션 자동 대응)
# 고정이 필요할 때만 채울 것. 카카오 콘솔에 등록된 값과 정확히 일치해야 한다.
VITE_KAKAO_REDIRECT_URI=
VITE_GOOGLE_CLIENT_ID=
# 비워두면 현재 origin + /auth/google. BE GOOGLE_REDIRECT_URI 및 구글 콘솔과 일치해야 한다.
VITE_GOOGLE_REDIRECT_URI=
VITE_SUPABASE_URL=

# true 면 아직 데이터가 없는 기능(환경 요약·일별, 홈 환경 추천, 예산 세트)을 목데이터로 보여준다.
# 실제 데이터가 들어오면 지우거나 false 로 둔다. (src/mocks/unready.ts)
VITE_MOCK_UNREADY=
